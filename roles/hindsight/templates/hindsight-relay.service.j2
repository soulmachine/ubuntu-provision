[Unit]
Description=Hindsight relay: 127.0.0.1:8888 to mac-mini-m2 over Tailscale, else m2's reverse SSH tunnel

[Service]
ExecStart=/usr/bin/python3 {{ hindsight_home }}/.local/bin/hindsight-relay 8888 {{ hindsight_relay_upstreams | join(' ') }}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
