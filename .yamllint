---
extends: default

rules:
  # Several tasks carry long single-line shell/content values (apt repo deb lines,
  # the claude-mem perl one-liner) that don't wrap cleanly; allow them.
  line-length:
    max: 200
  # The repo writes loop flow-mappings as `{ key: x, value: y }` (spaces inside).
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  truthy:
    check-keys: false
  document-start: disable
  # Required by ansible-lint's yaml rule.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
