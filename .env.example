# GITHUB_TOKEN is deliberately NOT here. The dotenv role rebuilds its ~/.bashrc block from
# this file, so a copy here would fight with ~/.local/bin/gh-token-fleet, which owns the PAT
# on the personal hosts and writes the export outside that block. The github, bun and mise
# roles read it from the environment with a `gh auth token` fallback, so the shell export is
# enough. See ~/.agents/docs/github-auth.md.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxx

# Optional: lets the tailscale role disable node-key expiry for this machine (the CLI has
# no equivalent command, so the role calls the REST API).
#
# Create an OAuth client at https://login.tailscale.com/admin/settings/trust-credentials
# with the `devices:core` write scope. The secret does not expire, is owned by the tailnet
# rather than by a person, and its use is recorded in the configuration audit log. Set both
# halves or neither; half a pair fails the play.
#
# TAILSCALE_API_ACCESS_TOKEN (a personal access token) is NO LONGER SUPPORTED: fully
# permitted, no scopes, and expires 90 days after minting. The role fails with migration
# instructions if it finds one set without an OAuth client.
#TAILSCALE_OAUTH_CLIENT_ID=kxxxxxxxxCNTRL
#TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxx

# Optional: force the github role to use a specific SSH key when ~/.ssh holds several.
# Accepts an absolute path, a ~/ path, or a bare name resolved under ~/.ssh; the .pub
# suffix is optional. When unset, the preferred key by type is used (ed25519 > ecdsa > rsa).
#GITHUB_SSH_KEY=id_ed25519

# Every variable set here is also exported into ~/.bashrc by the `dotenv` role, above the
# interactive guard, so non-interactive shells (ssh host 'cmd', git hooks, systemd units,
# and the `bash -lc "... ansible-playbook ..."` remote-run form) see it too. Edit this
# file, then re-run the playbook; never hand-edit the block in ~/.bashrc.

# Optional: the TypeSafe API key (https://console.typesafe.ai/keys) that the `typesafe`
# role writes into ~/.claude/settings.json's `env` for the fast-jev-compaction and
# claude-jev Claude Code plugins. Unset, that role skips entirely and installs nothing.
#TYPESAFE_API_KEY=apikey_xxxxx
